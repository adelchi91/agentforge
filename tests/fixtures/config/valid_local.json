{
  "schema_version": 1,
  "tracker": {
    "type": "local",
    "local_root": "docs/work-items"
  },
  "identifier": {
    "pattern": "^STORY-\\d{3,}$",
    "examples": ["STORY-001", "STORY-042"]
  },
  "context": {
    "max_bytes": 8000
  },
  "traceability": {
    "mode": "off"
  },
  "scope": {
    "mode": "deny-structured",
    "agents": {
      "independent-reviewer": {
        "allow": []
      },
      "verifier": {
        "allow": ["tests/", "src/"]
      }
    }
  },
  "migration_policy": {
    "enabled": false
  },
  "quality": {
    "post_edit": "off"
  }
}
