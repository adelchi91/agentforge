{
  "schema_version": 1,
  "tracker": {
    "type": "local",
    "local_root": "docs/work-items"
  },
  "identifier": {
    "pattern": "([",
    "examples": ["STORY-001"]
  },
  "context": {
    "max_bytes": 8000
  },
  "traceability": {
    "mode": "off"
  },
  "scope": {
    "mode": "off",
    "agents": {}
  },
  "migration_policy": {
    "enabled": false
  },
  "quality": {
    "post_edit": "off"
  }
}
