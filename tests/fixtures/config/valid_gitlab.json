{
  "schema_version": 1,
  "tracker": {
    "type": "gitlab",
    "repository": "adelchi91-group/agentforge"
  },
  "identifier": {
    "pattern": "^#\\d+$",
    "examples": ["#1", "#123"]
  },
  "context": {
    "max_bytes": 8000
  },
  "traceability": {
    "mode": "off"
  },
  "scope": {
    "mode": "observe",
    "agents": {}
  },
  "migration_policy": {
    "enabled": false
  },
  "quality": {
    "post_edit": "report"
  }
}
